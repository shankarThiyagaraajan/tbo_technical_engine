# tbo_technical_engine: setting names only, no values (rule: only .env.example is ever committed).
# Every setting is the environment variable TBO_TECHNICAL_<NAME>; a secret can be given as TBO_TECHNICAL_<NAME>_FILE=<path>
# (a path, never the value). The service reads the process environment only (no .env lookup);
# the platform stack sets these from tbo_platform deploy/env and $TBO_SECRETS_DIR/<mode>/.
# Lines are commented because an empty value would override the default; uncomment to set one.

# Set by the deploy. Default: '0.0.0'.
# TBO_TECHNICAL_VERSION=

# postgresql+asyncpg://tbo_<short>:<password>@postgres:5432/tbo_<mode> (deploy/scripts/provision.py env). Secret: set the _FILE form (path to a file holding it).
# TBO_TECHNICAL_DATABASE_URL_FILE=

# Secret: set the _FILE form (path to a file holding it).
# TBO_TECHNICAL_REDIS_URL_FILE=

# Default: 'INFO'.
# TBO_TECHNICAL_LOG_LEVEL=

# Default: True.
# TBO_TECHNICAL_LOG_JSON=

# JWKS file with the platform's public keys; needed to verify incoming service tokens.
# TBO_TECHNICAL_TOKEN_PUBLIC_KEYS_FILE=

# The platform token issuer, for tokens on outgoing calls.
# TBO_TECHNICAL_TOKEN_ISSUER_URL=

# This component's credential at the token issuer. Secret: set the _FILE form (path to a file holding it).
# TBO_TECHNICAL_TOKEN_CLIENT_SECRET_FILE=

# The repository's project at the hosted Sentry or GlitchTip; unset means no error reporting. Secret: set the _FILE form (path to a file holding it).
# TBO_TECHNICAL_SENTRY_DSN_FILE=

# deploy/tokens/rate_limits.yaml (mounted by the services file): the per-caller, per-route limits this component enforces (`rate_limit.py`). Unset means the built-in default for every caller and route.
# TBO_TECHNICAL_RATE_LIMITS_FILE=

# Default: 1048576.
# TBO_TECHNICAL_REQUEST_MAX_BYTES=

# The bundled contract this service serves at GET /openapi.json (scripts/vendor_contract.sh writes it). Default: contract/openapi.json.
# TBO_TECHNICAL_CONTRACT_FILE=

# The market feed (candle history, feed status); needed by the signal worker.
# TBO_TECHNICAL_MARKET_FEED_URL=

# The fundamental engine (the universe); needed by the signal worker.
# TBO_TECHNICAL_FUNDAMENTAL_URL=

# Parquet cache of candles for research and backtests (`store/research_cache.py`). Not committed (`.dev/`). Default: .dev/research_cache.
# TBO_TECHNICAL_RESEARCH_CACHE_DIR=
# TBO_TECHNICAL_FILINGS_URL=
# TBO_TECHNICAL_CALENDAR_CACHE_FILE=

# A closed candle older than this when it arrives is stored but not evaluated (late entries are not entries). Default: 120.
# TBO_TECHNICAL_MAX_CANDLE_AGE_SECONDS=

# The strategy parameters (`config/strategies.yaml`); read at start, and a bad file stops the process. Default: config/strategies.yaml.
# TBO_TECHNICAL_STRATEGIES_FILE=

# A previous-session CPR narrower than this percent of its pivot makes the day `narrow` (trend day likely). Default: 0.25.
# TBO_TECHNICAL_CPR_NARROW_PCT=

# Wider than this: `wide` (range day likely). Starting values, to be tuned by the backtest. Default: 0.5.
# TBO_TECHNICAL_CPR_WIDE_PCT=


# The service's signals (tbo_signals): ids, kinds, labels, links. A bad file stops the process at start. Default: config/signals.yaml.
# TBO_TECHNICAL_SIGNALS_FILE=

# A port for the signal worker's own metrics (it has no API). Unset: not served. Default: unset.
# TBO_TECHNICAL_SIGNALS_METRICS_PORT=

# How much the service says about itself: off, metrics or full. Default: off in lab, metrics in paper and live.
# TBO_TECHNICAL_SIGNALS=
